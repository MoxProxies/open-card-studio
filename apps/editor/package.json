{
  "name": "@card-studio/editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @card-studio/scene-schema --filter @card-studio/plugin-sdk --filter @card-studio/plugin-scryfall-import --filter @card-studio/plugin-asset-pack-default build",
    "dev": "vite",
    "prebuild": "pnpm --filter @card-studio/scene-schema --filter @card-studio/plugin-sdk --filter @card-studio/plugin-scryfall-import --filter @card-studio/plugin-asset-pack-default build",
    "build": "tsc --noEmit && vite build && vite build --config vite.embed.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@card-studio/plugin-asset-pack-default": "workspace:*",
    "@card-studio/plugin-scryfall-import": "workspace:*",
    "@card-studio/plugin-sdk": "workspace:*",
    "@card-studio/scene-schema": "workspace:*",
    "konva": "^9.3.16",
    "lucide-react": "^1.30.0",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
