APP_NAME=open-card-studio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

CORS_ALLOWED_ORIGINS=http://localhost:4173

LOG_CHANNEL=stack
LOG_LEVEL=debug

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

# Social sign-in. A provider with no client id simply doesn't appear as an
# option — see config/services.php. Register the redirect URI
# {APP_URL}/api/auth/{provider}/callback with each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Where the frontend lives. Social sign-in hands the token back by
# redirecting here, and only these origins are accepted as a return
# target — an unchecked one turns the callback into an open redirect that
# leaks the token.
FRONTEND_URLS=http://localhost:4173,http://localhost:4174
